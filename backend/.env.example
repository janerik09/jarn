# Database
DATABASE_URL=postgresql://patching_user:patching_password@localhost:5432/patching_db

# Redis
REDIS_URL=redis://localhost:6379/0

# App Settings
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-in-production

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# LDAP Settings (Optional)
LDAP_ENABLED=false
LDAP_SERVER=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=admin_password
LDAP_USER_SEARCH_FILTER=(&(uid={username})(objectClass=inetOrgPerson))

# OAuth2 Settings (Optional)
OAUTH2_ENABLED=false
OAUTH2_PROVIDER=okta
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
OAUTH2_DISCOVERY_URL=https://your-domain/.well-known/openid-configuration

# SSH Settings
SSH_TIMEOUT=30
SSH_PORT=22

# Job Execution
MAX_PARALLEL_JOBS=10
MAX_RETRIES=3
RETRY_DELAY_SECONDS=60

# Patch Scanning
PATCH_SCAN_INTERVAL_HOURS=24
PATCH_REPOSITORY_PATH=/patch-repository

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
