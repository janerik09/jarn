# Copy to .env and fill in every value. .env is git-ignored; back it up.
# Without CREDENTIAL_ENCRYPTION_KEY, stored SSH keys, passwords and backup tokens cannot be decrypted.

# Database password (any strong value)
POSTGRES_PASSWORD=

# Signs access tokens. Use at least 32 random characters: openssl rand -hex 32
SECRET_KEY=

# Base64 of 32 random bytes, for AES-256-GCM: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Optional
# CORS_ORIGINS=https://jarn.example.com
# METRICS_TOKEN=
# AUDIT_RETENTION_DAYS=365
# BACKUP_KEEP_DAYS=14
